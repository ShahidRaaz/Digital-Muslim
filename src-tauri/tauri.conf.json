{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Digital Muslim Widget",
  "version": "0.1.0",
  "identifier": "com.digital-muslim.widget",


  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Digital Muslim Widget",

        "width": 360,
        "height": 700,
        "minWidth": 360,
        "minHeight": 600,

        "resizable": false,
        "fullscreen": false,

        "decorations": false,
        "transparent": true,
        "shadow": false,

        "alwaysOnTop": false,
        "skipTaskbar": true,

        "visible": true,
        "focus": true
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}